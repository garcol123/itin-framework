{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/places.schema.json",
  "title": "Place catalogue",
  "type": "object",
  "required": ["schema_version", "places"],
  "properties": {
    "schema_version": { "const": 1 },
    "places": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
      "additionalProperties": {
        "type": "object",
        "required": ["name", "description", "url", "kind"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri" },
          "kind": { "enum": ["place", "attraction", "station", "airport", "shop", "restaurant", "experience", "hotel"] },
          "coordinates": {
            "type": "object",
            "required": ["longitude", "latitude", "precision", "status", "source_url", "checked_on"],
            "properties": {
              "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
              "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
              "precision": { "enum": ["exact", "entrance", "station", "neighborhood"] },
              "status": { "enum": ["verified", "provisional"] },
              "source_url": { "type": "string", "format": "uri" },
              "checked_on": { "type": "string", "format": "date" }
            },
            "additionalProperties": false
          },
          "opening_hours": {
            "type": "object",
            "required": ["days", "opens", "closes"],
            "properties": {
              "days": { "type": "array", "items": { "enum": ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"] }, "uniqueItems": true },
              "opens": { "type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$" },
              "closes": { "type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$" },
              "note": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
