{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/constraints.schema.json",
  "title": "Optimization constraints",
  "type": "object",
  "required": ["schema_version", "constraints"],
  "properties": {
    "schema_version": { "const": 1 },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "severity", "description"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "kind": { "enum": ["fixed_booking", "avoid_booking", "luggage", "deadline", "opening_hours", "holiday", "scope_limit", "travel_buffer", "daily_start", "minimum_duration"] },
          "severity": { "enum": ["hard", "soft"] },
          "description": { "type": "string", "minLength": 1 },
          "activity_refs": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
          "booking_refs": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
          "date": { "type": "string", "format": "date" },
          "deadline": { "type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$" },
          "wake_not_before": { "$ref": "#/$defs/clock" },
          "readiness_minutes": { "type": "integer", "minimum": 0 },
          "activity_category": { "enum": ["meal"] },
          "meal_type": { "enum": ["breakfast", "lunch", "dinner"] },
          "minimum_duration_minutes": { "type": "integer", "minimum": 1 },
          "exceptions": {
            "type": "array",
            "items": { "$ref": "#/$defs/exception" },
            "uniqueItems": true
          }
        },
        "allOf": [
          {
            "if": { "properties": { "kind": { "const": "daily_start" } }, "required": ["kind"] },
            "then": { "required": ["wake_not_before", "readiness_minutes"] }
          },
          {
            "if": { "properties": { "kind": { "const": "minimum_duration" } }, "required": ["kind"] },
            "then": { "required": ["activity_category", "minimum_duration_minutes"] }
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "clock": { "type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$" },
    "exception": {
      "type": "object",
      "required": ["activity_ref", "reason"],
      "properties": {
        "activity_ref": { "$ref": "#/$defs/id" },
        "reason": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
